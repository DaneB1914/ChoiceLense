# Copy this file to .env for local development and supply your own Gemini API key.
# In Google AI Studio, configure GEMINI_API_KEY through the Secrets panel instead.
# This key is read by Express only. Never prefix it with VITE_ or commit .env.
GEMINI_API_KEY=""

# Optional server port (default: 3000).
PORT=3000

# Optional: disable development hot reload in hosted previews.
# Leave unset for local development; AI Studio manages this setting in its runtime.
# DISABLE_HMR=true
